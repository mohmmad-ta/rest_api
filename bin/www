#!/usr/bin/env node

/**
 * Module dependencies.
 */

const app = require('../app');
const debug = require('debug')('trees-api:server');
const http = require('http');
const mongoose = require("mongoose");
const { initWebSocket } = require('../controllers/wsController');
const ensureAdminAccount = require('../utils/ensureAdminAccount');
const ensureAccountTimestamps = require('../utils/ensureAccountTimestamps');
const ensureRestaurantCategories = require('../utils/ensureRestaurantCategories');
const { startOrderExpiryJob } = require('../utils/orderExpiry');
/**
 * Get port from environment and store in Express.
 */

const port = normalizePort(process.env.PORT || '3000');
const DB = process.env.MONGOOSE_URL;
app.set('port', port);

mongoose.set('strictQuery', true);

/**
 * Create HTTP server.
 */

const server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

server.on('error', onError);
server.on('listening', onListening);

initWebSocket(server);

const startServer = async () => {
  try {
    await mongoose.connect(DB);
    console.log('Connected to MongoDB database.');

    await ensureAdminAccount();
    await ensureRestaurantCategories();
    await ensureAccountTimestamps();
    startOrderExpiryJob();

    server.listen(port, () => {
      console.log(`App running on http://localhost:${port}`);
    });
  } catch (error) {
    console.error('Backend startup failed:', error);
    process.exit(1);
  }
};

startServer();
/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
